# Copy this file to .env for local dev (.env is gitignored, never commit real values).
# In Cloudflare Pages: Settings > Environment variables > add the same names.
# In GitHub Actions (for the scheduled rebuild): repo Settings > Secrets and
# variables > Actions > add the same names.

# Amazon Associates tracking tag. Leave unset until the account is approved --
# AffiliateLink.astro degrades to plain text (no link) when this is empty.
PUBLIC_AMAZON_ASSOCIATES_TAG=

# Cloudflare Turnstile SITE key (public — safe to expose client-side).
# Dashboard > Turnstile > add a widget bound to the production domain.
PUBLIC_TURNSTILE_SITE_KEY=

# The deployed Google Apps Script Web App /exec URL. See
# scripts/apps-script/README.md for how to get this.
PUBLIC_LEAD_CAPTURE_ENDPOINT=
