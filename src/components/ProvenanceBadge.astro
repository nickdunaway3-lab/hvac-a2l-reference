---
interface Props {
  confidence: "verified" | "needs_review";
  sourceUrl: string;
  retrievedAt: Date;
  notes?: string;
  /** Optional: an AHRI Reference Number, rendered as a link into AHRI's own
   * public single-record certificate lookup — never our own reproduction of
   * their directory data. See DECISIONS.md. */
  ahriReferenceNumber?: string;
}
const { confidence, sourceUrl, retrievedAt, notes, ahriReferenceNumber } = Astro.props;
const retrievedLabel = retrievedAt.toISOString().slice(0, 10);
---

<span class:list={["badge", confidence]}>
  {confidence === "verified" ? "Verified" : "Unconfirmed — check before relying on this"}
</span>
{
  notes && (
    <p class="note">{notes}</p>
  )
}
<p class="source-links">
  <a href={sourceUrl} target="_blank" rel="noopener noreferrer">Source</a>
  {" · retrieved "}{retrievedLabel}
  {
    ahriReferenceNumber && (
      <>
        {" · "}
        <a href="https://www.ahridirectory.org/" target="_blank" rel="noopener noreferrer">
          Verify AHRI #{ahriReferenceNumber} on ahridirectory.org
        </a>
        {" (search by \"AHRI Reference #\")"}
      </>
    )
  }
</p>
