---
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";

interface Props {
  title: string;
  description: string;
  /** Set true on any page that uses <AffiliateLink /> — renders the FTC
   * disclosure once, near the top, above the links it covers. */
  hasAffiliateLinks?: boolean;
}
const { title, description, hasAffiliateLinks = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · A2L Refrigerant Reference</title>
    <meta name="description" content={description} />
    <style>
      :root {
        --ink: #1a1f26;
        --muted: #5b6472;
        --line: #d9dee4;
        --bg: #ffffff;
        --bg-subtle: #f5f7f9;
        --verified: #1c6b3a;
        --verified-bg: #e7f5ec;
        --review: #9a5b00;
        --review-bg: #fdf1de;
        --link: #185ea8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.5;
      }
      header {
        border-bottom: 1px solid var(--line);
        padding: 0.9rem 1.25rem;
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
      }
      header a { color: var(--ink); text-decoration: none; font-weight: 600; }
      header nav a { color: var(--link); font-weight: 500; font-size: 0.95rem; margin-right: 1rem; }
      main { max-width: 68rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      footer {
        border-top: 1px solid var(--line);
        margin-top: 3rem;
        padding: 1.5rem 1.25rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
      th, td { border: 1px solid var(--line); padding: 0.5rem 0.6rem; text-align: left; vertical-align: top; }
      th { background: var(--bg-subtle); font-weight: 600; }
      .badge {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .badge.verified { color: var(--verified); background: var(--verified-bg); }
      .badge.needs_review { color: var(--review); background: var(--review-bg); }
      .note {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.25rem;
      }
      .source-links { font-size: 0.82rem; margin-top: 0.25rem; }
      .source-links a { color: var(--link); }
      .callout {
        background: var(--bg-subtle);
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        color: var(--muted);
        margin: 0 0 1.5rem;
      }
      .callout strong { color: var(--ink); }
      .affiliate-disclosure {
        background: var(--bg-subtle);
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        padding: 0.6rem 0.9rem;
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0 0 1.5rem;
      }
      .affiliate-link { color: var(--link); }

      .path-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin: 1.75rem 0;
      }
      @media (max-width: 40rem) {
        .path-grid { grid-template-columns: 1fr; }
      }
      .path-card {
        display: block;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        padding: 1.25rem;
        text-decoration: none;
        color: var(--ink);
        transition: border-color 0.15s ease;
      }
      .path-card:hover { border-color: var(--link); }
      .path-card h2 { margin: 0 0 0.4rem; font-size: 1.15rem; }
      .path-card p { margin: 0; color: var(--muted); font-size: 0.92rem; }
      .path-card .path-cta { color: var(--link); font-weight: 600; font-size: 0.88rem; display: inline-block; margin-top: 0.6rem; }

      .cta-box {
        border: 1px solid var(--link);
        background: var(--bg-subtle);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        margin: 1.75rem 0;
      }
      .cta-box p { margin: 0 0 0.6rem; }
      .cta-box a.button {
        display: inline-block;
        background: var(--link);
        color: white;
        text-decoration: none;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 0.35rem;
        font-size: 0.9rem;
      }

      .table-search {
        width: 100%;
        max-width: 24rem;
        padding: 0.5rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: 0.35rem;
        font: inherit;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">A2L Refrigerant Reference</a>
      <nav>
        <a href="/equipment-matching/">Look up equipment</a>
        <a href="/get-your-quote-reviewed/">Get your quote reviewed</a>
      </nav>
    </header>
    <main>
      {hasAffiliateLinks && <AffiliateDisclosure />}
      <slot />
    </main>
    <footer>
      Every value on this site carries a source, a retrieval date, and a confidence
      level. Rows marked "unconfirmed" are not facts yet — verify with the
      manufacturer or AHRI before relying on them.
    </footer>
  </body>
</html>
