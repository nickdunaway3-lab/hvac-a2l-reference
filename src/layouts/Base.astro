---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · A2L Refrigerant Reference</title>
    <meta name="description" content={description} />
    <style>
      :root {
        --ink: #1a1f26;
        --muted: #5b6472;
        --line: #d9dee4;
        --bg: #ffffff;
        --bg-subtle: #f5f7f9;
        --verified: #1c6b3a;
        --verified-bg: #e7f5ec;
        --review: #9a5b00;
        --review-bg: #fdf1de;
        --link: #185ea8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.5;
      }
      header {
        border-bottom: 1px solid var(--line);
        padding: 0.9rem 1.25rem;
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
      }
      header a { color: var(--ink); text-decoration: none; font-weight: 600; }
      header nav a { color: var(--link); font-weight: 500; font-size: 0.95rem; margin-right: 1rem; }
      main { max-width: 68rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      footer {
        border-top: 1px solid var(--line);
        margin-top: 3rem;
        padding: 1.5rem 1.25rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
      th, td { border: 1px solid var(--line); padding: 0.5rem 0.6rem; text-align: left; vertical-align: top; }
      th { background: var(--bg-subtle); font-weight: 600; }
      .badge {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .badge.verified { color: var(--verified); background: var(--verified-bg); }
      .badge.needs_review { color: var(--review); background: var(--review-bg); }
      .note {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.25rem;
      }
      .source-links { font-size: 0.82rem; margin-top: 0.25rem; }
      .source-links a { color: var(--link); }
    </style>
  </head>
  <body>
    <header>
      <a href="/">A2L Refrigerant Reference</a>
      <nav>
        <a href="/equipment-matching/">Equipment matching</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Every value on this site carries a source, a retrieval date, and a confidence
      level. Rows marked "unconfirmed" are not facts yet — verify with the
      manufacturer or AHRI before relying on them.
    </footer>
  </body>
</html>
