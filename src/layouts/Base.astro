---
import AffiliateDisclosure from "../components/AffiliateDisclosure.astro";

interface Props {
  title: string;
  description: string;
  /** Set true on any page that uses <AffiliateLink /> — renders the FTC
   * disclosure once, near the top, above the links it covers. */
  hasAffiliateLinks?: boolean;
}
const { title, description, hasAffiliateLinks = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · A2L Refrigerant Reference</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --ink: #16191f;
        --muted: #5b6472;
        --line: #dde2e7;
        --bg: #ffffff;
        --bg-subtle: #f6f8fa;
        --bg-sunken: #eef1f4;
        --verified: #1c6b3a;
        --verified-bg: #e7f5ec;
        --review: #9a5b00;
        --review-bg: #fdf1de;
        --accent: #0f6e5c;
        --accent-bg: #e4f4f0;
        --link: #185ea8;
        --link-bg: #eaf2fa;
        --radius: 0.6rem;
        --shadow: 0 1px 2px rgba(20, 24, 30, 0.06), 0 4px 14px rgba(20, 24, 30, 0.05);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      h1 { font-size: 1.7rem; letter-spacing: -0.01em; margin: 0 0 0.5rem; }
      h2 { font-size: 1.2rem; letter-spacing: -0.005em; }
      p { color: var(--ink); }
      header {
        border-bottom: 1px solid var(--line);
        padding: 0.9rem 1.25rem;
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: saturate(1.4) blur(6px);
        z-index: 10;
      }
      header a { color: var(--ink); text-decoration: none; font-weight: 700; }
      header nav a {
        color: var(--muted);
        font-weight: 600;
        font-size: 0.92rem;
        margin-right: 1.25rem;
        text-decoration: none;
      }
      header nav a:hover { color: var(--link); }
      main { max-width: 68rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      footer {
        border-top: 1px solid var(--line);
        margin-top: 3rem;
        padding: 1.5rem 1.25rem;
        color: var(--muted);
        font-size: 0.85rem;
      }
      table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        font-size: 0.9rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
      }
      th, td { padding: 0.6rem 0.7rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
      th {
        background: var(--bg-subtle);
        font-weight: 700;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--muted);
      }
      tbody tr:hover { background: var(--bg-subtle); }
      tbody tr:last-child td { border-bottom: none; }
      .badge {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
        white-space: nowrap;
      }
      .badge.verified { color: var(--verified); background: var(--verified-bg); }
      .badge.needs_review { color: var(--review); background: var(--review-bg); }
      .badge.refrigerant-r454b { color: var(--accent); background: var(--accent-bg); }
      .badge.refrigerant-r32 { color: var(--link); background: var(--link-bg); }
      .badge.refrigerant-r410a { color: var(--muted); background: var(--bg-sunken); }
      .note {
        font-size: 0.83rem;
        color: var(--muted);
        margin-top: 0.2rem;
      }
      .source-links { font-size: 0.82rem; margin-top: 0.25rem; }
      .source-links a { color: var(--link); }
      .row-details { font-size: 0.85rem; }
      .row-details > summary {
        cursor: pointer;
        color: var(--link);
        font-weight: 600;
        font-size: 0.82rem;
        list-style: none;
      }
      .row-details > summary::-webkit-details-marker { display: none; }
      .row-details > summary:hover { text-decoration: underline; }
      .row-details[open] > summary { margin-bottom: 0.4rem; }
      .row-details-hint { color: var(--muted); font-weight: 500; }
      .row-details-content { padding-top: 0.15rem; }
      .callout {
        background: var(--bg-subtle);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        color: var(--muted);
        margin: 0 0 1.5rem;
      }
      .callout strong { color: var(--ink); }
      .affiliate-disclosure {
        background: var(--bg-subtle);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.6rem 0.9rem;
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0 0 1.5rem;
      }
      .affiliate-link { color: var(--link); }

      .path-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin: 1.75rem 0;
      }
      @media (max-width: 40rem) {
        .path-grid { grid-template-columns: 1fr; }
      }
      .path-card {
        display: block;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.4rem;
        text-decoration: none;
        color: var(--ink);
        background: var(--bg);
        box-shadow: var(--shadow);
        transition: transform 0.12s ease, border-color 0.12s ease;
      }
      .path-card:hover { border-color: var(--link); transform: translateY(-1px); }
      .path-card h2 { margin: 0 0 0.4rem; font-size: 1.15rem; }
      .path-card p { margin: 0; color: var(--muted); font-size: 0.92rem; }
      .path-card .path-cta { color: var(--link); font-weight: 700; font-size: 0.88rem; display: inline-block; margin-top: 0.7rem; }

      .cta-box {
        border: 1px solid var(--line);
        border-left: 3px solid var(--accent);
        background: var(--accent-bg);
        border-radius: var(--radius);
        padding: 1.1rem 1.3rem;
        margin: 2rem 0;
      }
      .cta-box p { margin: 0 0 0.7rem; }
      .cta-box a.button {
        display: inline-block;
        background: var(--accent);
        color: white;
        text-decoration: none;
        font-weight: 700;
        padding: 0.55rem 1.1rem;
        border-radius: 0.4rem;
        font-size: 0.9rem;
      }
      .cta-box a.button:hover { opacity: 0.92; }

      .search-shell {
        position: relative;
        max-width: 32rem;
      }
      .search-shell svg {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        pointer-events: none;
      }
      .table-search {
        width: 100%;
        padding: 0.65rem 0.8rem 0.65rem 2.3rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        font: inherit;
        font-size: 1rem;
      }
      .table-search:focus {
        outline: none;
        border-color: var(--link);
        box-shadow: 0 0 0 3px var(--link-bg);
      }

      .tabs {
        display: inline-flex;
        gap: 0.25rem;
        background: var(--bg-sunken);
        padding: 0.25rem;
        border-radius: 999px;
        margin-bottom: 1.25rem;
      }
      .tab-button {
        border: none;
        background: transparent;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
        font: inherit;
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--muted);
        cursor: pointer;
      }
      .tab-button[aria-selected="true"] {
        background: var(--bg);
        color: var(--ink);
        box-shadow: var(--shadow);
      }
      .tab-panel[hidden] { display: none; }

      .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.25rem 0 1.25rem;
      }
      .chip {
        border: 1px solid var(--line);
        background: var(--bg);
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
      }
      .chip:hover { border-color: var(--link); }
      .chip[aria-pressed="true"] {
        background: var(--link-bg);
        border-color: var(--link);
        color: var(--link);
      }

      .model-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
      }
      .model-chip {
        display: inline-block;
        border: 1px solid var(--line);
        background: var(--bg);
        color: var(--ink);
        padding: 0.35rem 0.7rem;
        border-radius: 0.4rem;
        font: inherit;
        font-size: 0.83rem;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        text-decoration: none;
        cursor: pointer;
      }
      .model-chip:hover { border-color: var(--link); color: var(--link); }
      .model-chip[aria-pressed="true"] {
        background: var(--link-bg);
        border-color: var(--link);
        color: var(--link);
      }

      .brand-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        font-size: 0.68rem;
        font-weight: 800;
        color: white;
        margin-right: 0.45rem;
        flex: none;
        vertical-align: middle;
      }
      .brand-badge.goodman { background: #4f46e5; }
      .brand-badge.daikin { background: #e11d48; }
      .brand-badge.lennox { background: #b45309; }
      .brand-badge.default-brand { background: #64748b; }
      .brand-cell { display: inline-flex; align-items: center; }

      .glossary {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--bg);
        padding: 1.1rem 1.3rem;
        margin: 0 0 1.5rem;
      }
      .glossary h2 { margin: 0 0 0.75rem; font-size: 1.02rem; }
      .glossary dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.45rem 1rem;
        margin: 0;
      }
      @media (max-width: 36rem) {
        .glossary dl { grid-template-columns: 1fr; }
        .glossary dt { margin-top: 0.5rem; }
      }
      .glossary dt {
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--ink);
        white-space: nowrap;
      }
      .glossary dd {
        margin: 0;
        font-size: 0.87rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">A2L Refrigerant Reference</a>
      <nav>
        <a href="/equipment/">Look up equipment</a>
        <a href="/get-your-quote-reviewed/">Get your quote reviewed</a>
      </nav>
    </header>
    <main>
      {hasAffiliateLinks && <AffiliateDisclosure />}
      <slot />
    </main>
    <footer>
      <a href="/methodology/">How this site sources and verifies data</a>
    </footer>
  </body>
</html>
